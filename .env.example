# ==============================================================================
# SLADSS Environment Configuration Template (.env.example)
# Smart Logistics Analytics & Decision Support System (v2.0)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env: `cp .env.example .env` (or copy in Windows)
# 2. Adjust values to match your local or Docker setup.
# 3. DO NOT commit the .env file to Git repository (it is in .gitignore).
# ==============================================================================

# Application Run Mode: development | testing | production
APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Primary Database Configuration (PostgreSQL 16 Alpine Container)
# ------------------------------------------------------------------------------
# For Local machine (host): DB_HOST=localhost (Port 5432)
# For Docker Compose:      DB_HOST=postgres_db
DB_DIALECT=postgresql
DB_HOST=postgres_db
DB_PORT=5432
DB_NAME=sladss_db
DB_USER=sladss_user
DB_PASSWORD=sladss_password

# Database Schemas
DB_SCHEMA_STAGING=staging
DB_SCHEMA_WAREHOUSE=warehouse
DB_SCHEMA_MARTS=marts

# ------------------------------------------------------------------------------
# Data Pipeline & Mock Data Settings
# ------------------------------------------------------------------------------
DATA_SAMPLE_DIR=data/sample
ENABLE_SYNTHETIC_DATA=true
IDEMPOTENT_RELOAD=true
PIPELINE_BATCH_SIZE=1000

# ------------------------------------------------------------------------------
# AI & Machine Learning Configuration
# ------------------------------------------------------------------------------
# LLM Provider: openai | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# Local LLM via Ollama (Optional alternative)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.1:8b

# ------------------------------------------------------------------------------
# Web Dashboard (Streamlit)
# ------------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
